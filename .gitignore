# ==========================================
# PolicySathi .gitignore
# ==========================================

# ---------- Dependencies ----------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Next.js ----------
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# ---------- Environment Variables ----------
.env
.env.*
!.env.example

# ---------- OS Files ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
*.swp
*.swo
*~

# ---------- IDE / Editors ----------
.vscode/settings.json
.vscode/launch.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath

# ---------- Debug & Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
build.log
lint_output.txt
tsc_output.txt
tsc_error.log
components_lint.txt

# ---------- Testing ----------
/coverage/
*.lcov
.nyc_output/

# ---------- Keys & Certificates ----------
*.pem
*.key
*.cert
*.p12

# ---------- Supabase Local ----------
/supabase/.temp/
/supabase/.branches/

# ---------- Vercel ----------
.vercel/

# ---------- Misc Build Artifacts ----------
*.tgz
*.tar.gz
*.zip

# ---------- AI Agents & Notes ----------
.agents/
MOBILE_ACCESS.md
MOBILE_ACCESS_FIX.md
TROUBLESHOOTING.md
